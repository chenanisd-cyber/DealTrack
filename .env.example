# ---------------------------------------------------------------------------
# DealTrack.be — variables d'environnement
#
# Copier en .env et renseigner. Ce fichier d'exemple est versionné ;
# le .env réel ne doit JAMAIS l'être (voir .gitignore).
#
# config/settings/prod.py échoue au démarrage si une variable requise manque,
# plutôt que de démarrer en configuration dégradée.
# ---------------------------------------------------------------------------

# --- Django ----------------------------------------------------------------
# Générer avec :
#   python3 -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=0
DJANGO_SETTINGS_MODULE=config.settings.prod
DJANGO_ALLOWED_HOSTS=dealtrack.be,www.dealtrack.be
CSRF_TRUSTED_ORIGINS=https://dealtrack.be,https://www.dealtrack.be

# Clé de signature des JWT. Distincte de SECRET_KEY : la faire tourner
# invalide tous les jetons sans déconnecter les sessions du front-office.
JWT_SIGNING_KEY=

# --- PostgreSQL ------------------------------------------------------------
POSTGRES_DB=dealtrack
POSTGRES_USER=dealtrack
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_SSLMODE=require

# --- Paiement --------------------------------------------------------------
# « sandbox » rejoue les réponses hors ligne ; « stripe » appelle l'API réelle.
PAYMENT_GATEWAY=sandbox
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Courrier --------------------------------------------------------------
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
