            "description": "Aucune authentification. Le compte renvoyé exclut les offres en attente de modération : le filtrage d'accès s'applique aussi à l'anonyme."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const d = pm.response.json();",
                  "pm.test(\"format paginé\", () => pm.expect(d).to.have.keys(\"count\",\"next\",\"previous\",\"results\"));",
